<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- lan.js (the desktop peer this app talks to) is deliberately plain HTTP,
         auth'd by a shared bearer key rather than TLS — same model as
         Chromecast/Spotify Connect. Peer addresses are arbitrary user-entered
         LAN IPs, so they can't be pre-allowlisted by domain in a scoped
         network security config; Android blocks all cleartext traffic by
         default for apps targeting API 28+, which silently broke every LAN
         fetch/stream (including ExoPlayer's). -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- @mediagrid/capacitor-native-audio: Media3 ExoPlayer + MediaSessionService,
             runs as a foreground service so playback survives backgrounding/screen lock
             and gets lock-screen/notification controls. -->
        <service
            android:name="us.mediagrid.capacitorjs.plugins.nativeaudio.AudioPlayerService"
            android:description="@string/audio_player_service_description"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ (API 33) requires this to actually show the media
         notification; the plugin doesn't request it at runtime itself
         (see MainActivity.java), so it's declared and requested here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sideloaded outside the Play Store, so self-updating (UpdaterPlugin)
         has to launch the system package installer itself instead of an
         app-store update flow. Declaring this doesn't grant it silently —
         the OS still shows its own "allow this app to install unknown apps"
         prompt the first time, same as manually installing an APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
