{
  "name": "audex-player",
  "productName": "Audex",
  "version": "1.3.0",
  "description": "Audex — minimal desktop music player",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "node scripts/build-info.js && electron-builder",
    "build": "node scripts/check-bundles.js win32 && node scripts/build-info.js && electron-builder --win --publish never",
    "postinstall": "node scripts/fetch-ytdlp.js && node scripts/fetch-fpcalc.js",
    "test": "node test-audex.js && node test-lan.js"
  },
  "build": {
    "appId": "com.audex.player",
    "productName": "Audex",
    "copyright": "Copyright © 2026 Heorhii Litovskyi",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "lan.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "LICENSE",
      "package.json",
      "build-info.json",
      ".puppeteerrc.cjs",
      "build/icon.png",
      "build/icon.svg",
      "chromium-bundle/**",
      "yt-dlp-bundle/**",
      "fpcalc-bundle/**"
    ],
    "asarUnpack": [
      "chromium-bundle/**",
      "yt-dlp-bundle/**",
      "fpcalc-bundle/**",
      "node_modules/ffmpeg-static/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "zhotheone",
      "repo": "audex-player"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "AudioVideo;Audio;Player",
      "synopsis": "Minimal desktop music player",
      "description": "Audex is a minimal local music player built with Electron.",
      "maintainer": "Heorhii Litovskyi <zhotheone@gmail.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "audex"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "keywords": [],
  "author": "Heorhii Litovskyi <zhotheone@gmail.com>",
  "contributors": [
    "Heorhii Litovskyi <zhotheone@gmail.com> (fork maintainer)"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.12.3",
    "puppeteer": "^23.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
